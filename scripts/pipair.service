[Unit]
Description=PiPair synchronized video player (@ROLE@)
After=network-online.target sound.target bluetooth.target systemd-udev-settle.service
Wants=network-online.target bluetooth.target

[Service]
Type=simple
User=pipair
Group=pipair
SupplementaryGroups=video render audio gpio bluetooth
WorkingDirectory=/opt/pipair
Environment=PYTHONUNBUFFERED=1
Environment=PIPAIR_DATA=/var/lib/pipair
Environment=PIPAIR_PORT=@PORT@
Environment=PIPAIR_ROLE=@ROLE@
Environment=PIPAIR_BACKEND=kms
ExecStart=/usr/bin/python3 -m pipair
# bind to port 80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Headroom for file descriptors (dmabufs, V4L2 devices, sockets)
LimitNOFILE=16384
# Allow a core dump when the process is killed by a signal. systemd's default
# is 0, which silently discards them; systemd-coredump (see scripts/diagnostics.sh)
# needs this to capture anything.
LimitCORE=infinity
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
